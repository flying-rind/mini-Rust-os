{
    "rust-analyzer.check.allTargets": false,
    "rust-analyzer.checkOnSave": true,

    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer",
        "editor.formatOnSave": true
    },
    "files.associations": {
        "sqlite3.h": "c",
        "pthread_impl.h": "c",
        "mman.h": "c",
        "unistd.h": "c",
        "array": "c",
        "string_view": "c",
        "initializer_list": "c",
        "stdlib.h": "c",
        "stddef.h": "c"
    }
}

